---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="container-app">
    <!-- Sidebar -->
    <aside class="app-sidebar">
      <div class="brand">
        <div class="brand-badge">
          <!-- Simple logo glyph -->
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="4" y="4" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.5"/>
            <path d="M8 9h8M8 13h5M8 17h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <div class="brand-title">Ocean Notes</div>
          <div style="font-size:12px;color:var(--color-text-muted)">Simple. Clean. Fast.</div>
        </div>
      </div>

      <div class="sidebar-actions">
        <button id="btn-new" class="btn btn-primary" title="New note (N)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          New
        </button>
        <button id="btn-delete" class="btn btn-danger" title="Delete note (Del)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 7h12M9 7v12m6-12v12M4 7h16l-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 7Zm3-3h10l1 3H6l1-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          Delete
        </button>
      </div>

      <div class="sidebar-section-title">Search</div>
      <div class="search">
        <span class="icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </span>
        <input id="search" placeholder="Search notes..." />
      </div>

      <div class="sidebar-section-title">Notes</div>
      <div id="note-list" class="note-list" aria-live="polite"></div>

      <div class="footer">Tips: Press N to create a note, Ctrl/Cmd+S to save</div>
    </aside>

    <!-- Header -->
    <header class="app-header">
      <div class="header-left">
        <span class="badge" id="note-count">0 notes</span>
        <span class="badge" id="status-badge" aria-live="polite">Idle</span>
      </div>
      <div class="header-right">
        <button class="btn" id="btn-export" title="Export notes as JSON">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0l-4-4m4 4 4-4M5 21h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Export
        </button>
        <button class="btn" id="btn-import" title="Import notes from JSON">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 21V9m0 0 4 4m-4-4-4 4M19 3H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Import
        </button>
        <input id="file-input" type="file" accept="application/json" hidden />
      </div>
    </header>

    <!-- Main -->
    <main class="app-main">
      <section class="surface">
        <div class="surface-left">
          <div class="sidebar-section-title">All Notes</div>
          <div id="note-list-side" class="note-list"></div>
        </div>

        <div class="surface-right">
          <div class="editor-header">
            <input id="note-title" class="input-title" type="text" placeholder="Note title..." />
            <div class="editor-actions">
              <button id="btn-save" class="btn btn-primary" title="Save (Ctrl/Cmd+S)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Save
              </button>
              <button id="btn-clear" class="btn" title="Clear editor">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                Clear
              </button>
            </div>
          </div>
          <textarea id="note-content" class="textarea" placeholder="Start typing your note..."></textarea>
        </div>
      </section>
    </main>
  </div>

  <script is:raw>
    // Notes App - localStorage persistence
    // PUBLIC_INTERFACE
    /**
     * getNotes
     * Retrieve notes from localStorage.
     * Returns an array of note objects: { id: string, title: string, content: string, updatedAt: number }
     */
    function getNotes() {
      try {
        const raw = localStorage.getItem('ocean_notes_v1');
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    // PUBLIC_INTERFACE
    /**
     * saveNotes
     * Persist notes array to localStorage.
     * @param {Array} notes
     */
    function saveNotes(notes) {
      localStorage.setItem('ocean_notes_v1', JSON.stringify(notes));
    }

    // PUBLIC_INTERFACE
    /**
     * formatTime
     * @param {number} ts - epoch ms
     * @returns {string} relative or locale time string
     */
    function formatTime(ts) {
      const d = new Date(ts);
      const diff = Date.now() - ts;
      const mins = Math.floor(diff / 60000);
      if (mins < 1) return 'just now';
      if (mins < 60) return mins + 'm ago';
      const hrs = Math.floor(mins / 60);
      if (hrs < 24) return hrs + 'h ago';
      return d.toLocaleString();
    }

    // PUBLIC_INTERFACE
    /**
     * createNote
     * Create a new empty note and persist it.
     * @returns {object} note
     */
    function createNote() {
      const id = Math.random().toString(36).slice(2);
      const now = Date.now();
      const note = { id, title: 'Untitled', content: '', updatedAt: now };
      const notes = getNotes();
      notes.unshift(note);
      saveNotes(notes);
      return note;
    }

    // PUBLIC_INTERFACE
    /**
     * updateNote
     * Update note title/content by id.
     */
    function updateNote(id, data) {
      const notes = getNotes();
      const idx = notes.findIndex(n => n.id === id);
      if (idx >= 0) {
        notes[idx] = { ...notes[idx], ...data, updatedAt: Date.now() };
        saveNotes(notes);
      }
    }

    // PUBLIC_INTERFACE
    /**
     * deleteNote
     * Remove a note by id.
     */
    function deleteNote(id) {
      const notes = getNotes().filter(n => n.id !== id);
      saveNotes(notes);
    }

    // UI state
    let selectedId = null;
    let filterText = '';

    // Elements
    const elListPrimary = document.getElementById('note-list');
    const elListSide = document.getElementById('note-list-side');
    const elSearch = document.getElementById('search');
    const elTitle = document.getElementById('note-title');
    const elContent = document.getElementById('note-content');
    const elCount = document.getElementById('note-count');
    const elStatus = document.getElementById('status-badge');
    const elBtnNew = document.getElementById('btn-new');
    const elBtnDelete = document.getElementById('btn-delete');
    const elBtnSave = document.getElementById('btn-save');
    const elBtnClear = document.getElementById('btn-clear');
    const elBtnExport = document.getElementById('btn-export');
    const elBtnImport = document.getElementById('btn-import');
    const elFile = document.getElementById('file-input');

    function setStatus(text, timeout = 1500) {
      elStatus.textContent = text;
      if (timeout) {
        setTimeout(() => (elStatus.textContent = 'Idle'), timeout);
      }
    }

    function highlight(text, query) {
      if (!query) return text;
      const idx = text.toLowerCase().indexOf(query.toLowerCase());
      if (idx === -1) return text;
      return (
        text.slice(0, idx) +
        '<mark style="background: rgba(37,99,235,0.15); color: inherit; padding: 0 2px; border-radius: 4px;">' +
        text.slice(idx, idx + query.length) +
        '</mark>' +
        text.slice(idx + query.length)
      );
    }

    function renderLists() {
      const notes = getNotes();
      const filtered = filterText
        ? notes.filter(n =>
            (n.title + ' ' + n.content).toLowerCase().includes(filterText.toLowerCase())
          )
        : notes;

      elCount.textContent = notes.length + (notes.length === 1 ? ' note' : ' notes');

      const itemHtml = (n) => `
        <div class="note-item ${n.id === selectedId ? 'active' : ''}" data-id="${n.id}" tabindex="0" role="button" aria-pressed="${n.id === selectedId}">
          <div class="note-meta">
            <div class="note-title">${highlight(n.title || 'Untitled', filterText)}</div>
            <div class="note-preview">${highlight((n.content || '').slice(0, 64) || 'No content yet', filterText)}</div>
            <div class="note-time">Updated ${formatTime(n.updatedAt)}</div>
          </div>
          <button class="btn" data-del="${n.id}" title="Delete">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 7h12M9 7v12m6-12v12M4 7h16l-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 7Zm3-3h10l1 3H6l1-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </button>
        </div>
      `;

      elListPrimary.innerHTML = filtered.map(itemHtml).join('') || `
        <div class="empty-state">
          <div>No notes found.</div>
          <div>Click <span class="kbd">New</span> or press <span class="kbd">N</span> to create one.</div>
        </div>
      `;

      elListSide.innerHTML = filtered.map(itemHtml).join('') || `
        <div class="empty-state">
          <div>No notes yet.</div>
        </div>
      `;

      // Bind events
      function bind(container) {
        container.querySelectorAll('.note-item').forEach(el => {
          el.addEventListener('click', () => selectNote(el.getAttribute('data-id')));
          el.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              selectNote(el.getAttribute('data-id'));
            }
          });
        });
        container.querySelectorAll('button[data-del]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const id = btn.getAttribute('data-del');
            if (!id) return;
            const isCurrent = id === selectedId;
            deleteNote(id);
            setStatus('Deleted');
            if (isCurrent) {
              selectedId = null;
              elTitle.value = '';
              elContent.value = '';
            }
            renderLists();
          });
        });
      }

      bind(elListPrimary);
      bind(elListSide);
    }

    function selectNote(id) {
      selectedId = id;
      const note = getNotes().find(n => n.id === id);
      if (note) {
        elTitle.value = note.title || '';
        elContent.value = note.content || '';
      }
      renderLists();
    }

    function newNote() {
      const note = createNote();
      selectedId = note.id;
      elTitle.value = note.title;
      elContent.value = note.content;
      setStatus('Created');
      renderLists();
      elTitle.focus();
      elTitle.select();
    }

    function saveCurrent() {
      if (!selectedId) {
        // If no selection but content exists, create new note implicitly
        if (elTitle.value.trim() || elContent.value.trim()) {
          const n = createNote();
          selectedId = n.id;
        } else {
          setStatus('Nothing to save', 1200);
          return;
        }
      }
      updateNote(selectedId, { title: elTitle.value.trim() || 'Untitled', content: elContent.value });
      setStatus('Saved');
      renderLists();
    }

    // Wire controls
    elBtnNew.addEventListener('click', newNote);
    elBtnSave.addEventListener('click', saveCurrent);
    elBtnDelete.addEventListener('click', () => {
      if (!selectedId) return;
      deleteNote(selectedId);
      setStatus('Deleted');
      selectedId = null;
      elTitle.value = '';
      elContent.value = '';
      renderLists();
    });
    elBtnClear.addEventListener('click', () => {
      elTitle.value = '';
      elContent.value = '';
      setStatus('Cleared');
    });

    // Search filter
    elSearch.addEventListener('input', (e) => {
      filterText = e.target.value || '';
      renderLists();
    });

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      // New note: N
      if (e.key.toLowerCase() === 'n' && !e.metaKey && !e.ctrlKey && !e.altKey) {
        e.preventDefault();
        newNote();
      }
      // Save: Ctrl/Cmd+S
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
        e.preventDefault();
        saveCurrent();
      }
      // Delete: Delete key
      if (e.key === 'Delete') {
        if (selectedId) {
          e.preventDefault();
          deleteNote(selectedId);
          selectedId = null;
          elTitle.value = '';
          elContent.value = '';
          setStatus('Deleted');
          renderLists();
        }
      }
    });

    // Export/Import
    elBtnExport.addEventListener('click', () => {
      const notes = getNotes();
      const blob = new Blob([JSON.stringify(notes, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'ocean-notes.json';
      a.click();
      URL.revokeObjectURL(url);
      setStatus('Exported');
    });

    elBtnImport.addEventListener('click', () => elFile.click());

    elFile.addEventListener('change', async (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      try {
        const text = await file.text();
        const data = JSON.parse(text);
        if (Array.isArray(data)) {
          // naive validate shape
          const normalized = data.map(d => ({
            id: (d && d.id) ? String(d.id) : Math.random().toString(36).slice(2),
            title: (d && d.title) ? String(d.title) : 'Untitled',
            content: (d && d.content) ? String(d.content) : '',
            updatedAt: (d && d.updatedAt && Number.isFinite(+d.updatedAt)) ? +d.updatedAt : Date.now()
          }));
          saveNotes(normalized);
          setStatus('Imported');
          selectedId = normalized[0]?.id || null;
          if (selectedId) {
            elTitle.value = normalized[0].title || '';
            elContent.value = normalized[0].content || '';
          } else {
            elTitle.value = '';
            elContent.value = '';
          }
          renderLists();
        } else {
          setStatus('Invalid file', 1800);
        }
      } catch {
        setStatus('Import failed', 1800);
      } finally {
        e.target.value = '';
      }
    });

    // Initial seed
    if (getNotes().length === 0) {
      const example = {
        id: Math.random().toString(36).slice(2),
        title: 'Welcome to Ocean Notes',
        content:
`This is your minimalist notes app.

Tips:
• Press N to create a new note
• Ctrl/Cmd+S to save the current note
• Use the search to filter notes
• Export/Import your notes as JSON

Enjoy your flow.`,
        updatedAt: Date.now()
      };
      saveNotes([example]);
      selectedId = example.id;
    }

    // Initialize UI
    (function init() {
      const first = getNotes()[0];
      if (first) {
        selectedId = first.id;
        elTitle.value = first.title || '';
        elContent.value = first.content || '';
      }
      renderLists();
    })();
  </script>
</Layout>
